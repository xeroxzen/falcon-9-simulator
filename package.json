{
  "name": "falcon-9-simulator",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "sim:ascent": "tsx src/cli/run-ascent.ts",
    "sim:mission": "tsx src/cli/run-mission.ts",
    "sim:validate": "tsx src/cli/run-validation.ts",
    "sim:montecarlo": "tsx src/cli/montecarlo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^9.121.4",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "postprocessing": "^6.36.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
